# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose behind NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for cron endpoints under /api/cron/*. Generate a long random value.
CRON_SECRET=
MASTER_USER_ID=

# ---------- Google Workspace (mail + calendar) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=

# ---------- Slack ----------
SLACK_BOT_TOKEN=

# ---------- Onboarding automation ----------
# off      the automation does not run; nobody is contacted (default)
# dry_run  reports what it would send; sends nothing and saves nothing
# sandbox  sends for real, but every recipient is redirected below
# live     sends to real joiners
#
# Leave this unset or `off` until the shadow-run period is complete. Anything
# unrecognised is treated as `off`.
ONBOARDING_MODE=off

# Required when ONBOARDING_MODE=sandbox. Every email recipient and calendar
# attendee is replaced by this address; without it the run defers rather than
# risk contacting a real joiner.
ONBOARDING_SANDBOX_EMAIL=
# Required when ONBOARDING_MODE=sandbox for any Slack step.
ONBOARDING_SANDBOX_SLACK_CHANNEL=

# Time travel for staging, as YYYY-MM-DD. Lets a joiner's whole timeline be
# tested in one sitting. Ignored when ONBOARDING_MODE=live.
ONBOARDING_TODAY_OVERRIDE=

# Where operational alerts go: the run summary, tomorrow's preview, the
# pre-flight check and the attention digest. Without it those are logged only.
ONBOARDING_ALERT_SLACK_CHANNEL=
# The shared team channel the P&C-written introduction is posted to.
ONBOARDING_INTRO_SLACK_CHANNEL=
# Copied on every onboarding email, comma separated, so P&C keep a thread.
# Ignored in sandbox mode, which copies nobody.
ONBOARDING_CC_EMAILS=

# Facilitators added to each batched session, comma separated. Kept in config so
# a change of facilitator is not a code change.
ONBOARDING_TECH_ATTENDEES=
ONBOARDING_WARM_ATTENDEES=
ONBOARDING_PNC_ATTENDEES=
