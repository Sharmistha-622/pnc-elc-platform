# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose behind NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for cron endpoints under /api/cron/*. Generate a long random value.
CRON_SECRET=
MASTER_USER_ID=

# ---------- Google Workspace (mail + calendar) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=

# ---------- Slack ----------
SLACK_BOT_TOKEN=
