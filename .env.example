# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose behind NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for cron endpoints under /api/cron/*. Generate a long random value.
CRON_SECRET=
MASTER_USER_ID=

# ---------- Google Workspace (mail + calendar + drive) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
# Optional. Without it, employee documents stay in private Supabase Storage and
# are served by signed URL instead of being copied to Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---------- Vault (second Supabase project) ----------
# Core knows the vault's URL and a shared secret, and can call only the narrow
# Edge Functions the vault exposes. The vault's service-role key NEVER goes
# here — see docs/vault-setup.md.
VAULT_URL=
CORE_SUBMISSION_SECRET=

# ---------- Slack ----------
SLACK_BOT_TOKEN=
